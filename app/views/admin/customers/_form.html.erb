<%= form_with(model: [:admin, customer], class: "row g-3") do |f| %>
  <div class="col-md-6">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", placeholder: "Full Name" %>
  </div>

  <div class="col-md-6">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :phone, class: "form-label" %>
    <%= f.telephone_field :phone, class: "form-control" %>
  </div>

  <div class="col-md-6">
    <%= f.label :gender, class: "form-label" %>
    <%= f.select :gender, ['Male', 'Female', 'Other'], { prompt: "Select Gender" }, { class: "form-select" } %>
  </div>

  <% if false #customer.new_record? %>
    <div class="col-md-6">
      <%= f.label :password, class: "form-label" %>
      <%= f.password_field :password, class: "form-control" %>
    </div>
  <% end %>
  
  <div class="col-md-6">
    <%= f.label :business_name, class: "form-label" %>
    <%= f.text_field :business_name, class: "form-control", placeholder: "Business Name" %>
  </div>
  
  <div class="col-md-6">
    <%= f.label :business_type, class: "form-label" %>
    <%= f.text_field :business_type, class: "form-control", placeholder: "Business Type" %>
  </div>
  
  <div class="col-md-6">
    <%= f.label :aadhar_number, class: "form-label" %>
    <%= f.text_field :aadhar_number, class: "form-control", placeholder: "Aadhar Number" %>
  </div>

  <div class="col-12">
    <div class="form-check">
      <%= f.check_box :is_active, class: "form-check-input" %>
      <%= f.label :is_active, "Account Active", class: "form-check-label" %>
    </div>
  </div>

  <div class="col-12 mt-4">
    <%= f.submit class: "btn btn-success" %>
    <%= link_to "Back", admin_customers_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>