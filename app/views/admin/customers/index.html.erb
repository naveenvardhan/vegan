<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Customers</h1>
    <%= link_to 'Add New Customer', new_admin_customer_path, class: 'btn btn-primary' %>
  </div>
  
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <%= form_with url: admin_customers_path, method: :get, class: "row g-3 align-items-end" do |f| %>
        
        <div class="col-md-5">
          <%= f.label :query, "Search Name, Business, or Phone", class: "form-label small text-muted" %>
          <div class="input-group">
            <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
            <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: "Type to search..." %>
          </div>
        </div>

        <div class="col-md-3">
          <%= f.label :status, "Account Status", class: "form-label small text-muted" %>
          <%= f.select :status, 
              [['All Statuses', ''], ['Active', 'active'], ['Inactive', 'inactive']], 
              { selected: params[:status] }, 
              { class: "form-select" } %>
        </div>

        <div class="col-md-4">
          <%= f.submit "Filter", class: "btn btn-primary px-4" %>
          <%= link_to "Clear", admin_customers_path, class: "btn btn-outline-secondary" %>
        </div>

      <% end %>
    </div>
  </div>

  <table class="table table-hover shadow-sm bg-white">
    <thead class="table-dark">
      <tr>
        <th>Name</th>
        <th>Business Name</th>
        <!-- <th>Email</th> -->
        <th>Phone</th>
        <th>Business Type</th>
        <th>Address</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody class="font-14">
      <% @customers.each do |customer| %>
        <tr>
          <td><%= customer.name %></td>
          <td><%= customer.business_name %></td>
          <!-- <td><%= customer.email.presence || 'N/A' %></td> -->
          <td><%= customer.phone %></td>
          <td><%= customer.business_type&.humanize %></td>
          <td></td>
          <td>
            <span class="badge <%= customer.is_active ? 'bg-success' : 'bg-danger' %>">
              <%= customer.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td>
            <%= link_to 'Edit', edit_admin_customer_path(customer), class: 'btn btn-sm btn-outline-primary' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>