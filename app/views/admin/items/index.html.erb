<div class="container py-4" style="max-width:1500px;">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <% if params[:grade].present? %>
      <h1>Grade <%= params[:grade] %> Items</h1>
    <% else %>
      <h1>Grade A Items</h1>
    <% end %>
    <%= link_to 'Add New Item', new_admin_item_path, class: 'btn btn-primary' %>
  </div>
  
  <div class="card border-0 shadow-sm mb-4">
    <!-- <div class="mb-3 d-flex gap-2">

      <%= link_to "All Items",
            admin_items_path,
            class: "btn #{params[:type].blank? ? 'btn-dark' : 'btn-outline-dark'}" %>

      <%= link_to "Hotel Items",
            admin_items_path(type: "hotel"),
            class: "btn #{params[:type] == 'hotel' ? 'btn-success' : 'btn-outline-success'}" %>

      <%= link_to "Seller Items",
            admin_items_path(type: "seller"),
            class: "btn #{params[:type] == 'seller' ? 'btn-primary' : 'btn-outline-primary'}" %>

    </div> -->
    <div class="card-body">
      <%= form_with url: admin_items_path, method: :get, class: "row g-3" do |f| %>
        <div class="col-md-3">
          <%= f.text_field :query, value: params[:query], class: "form-control", placeholder: "Search items..." %>
        </div>
        <div class="col-md-2">
          <%= f.select :sub_category, Item::SUB_CATEGORIES, { include_blank: 'Select Sub Category', selected: params[:sub_category] }, { class: "form-select" } %>
        </div>
        <div class="col-md-2">
          <%= f.select :grade, Item::GRADES, { include_blank: 'Select Grade', selected: params[:grade] }, { class: "form-select" } %>
        </div>
        <div class="col-md-2">
          <%= f.select :business_type, ['hotel', 'seller'], { include_blank: 'Business Type', selected: params[:business_type] }, { class: "form-select" } %>
        </div>
        <div class="col-md-2 d-flex gap-2">
          <%= f.submit "Search", class: "btn btn-primary w-100" %>
          <%= link_to "Reset", admin_items_path, class: "btn btn-outline-secondary" %>
        </div>
      <% end %>
    </div>
  </div>

  <table class="table table-hover align-middle shadow-sm bg-white">
    <thead class="table-dark">
      <tr>
        <th>Image</th>
        <th>Name</th>
        <!-- <th>Category</th> -->
        <th>Sub Category</th>
        <th>Grade</th>
        <th>Hotel Price</th>
        <th>Seller Price</th>
        <th width="100px;">Show for Hotel</th>
        <th width="100px;">Show for Seller</th>
        <th>Priority</th>
        <th>Actions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%# <% @grouped_items.each do |sub_category, items| %>
      <% Item::SUB_CATEGORIES.each do |sub_category| %>
        <% items = @grouped_items[sub_category] %>
        <tr class="table-primary">
          <td colspan="11" class="fw-bold">
            <%= sub_category.present? ? sub_category.titleize : "Uncategorized" %>
            (<%= items&.count %>)
          </td>
        </tr>
        <% items.each do |item| %>
          <%= render partial: "item_row", locals: { item: item } %>
        <% end if items.present? %>
      <% end %>
    </tbody>
  </table>
</div>