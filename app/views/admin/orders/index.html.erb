<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2>All Orders</h2>
    <%= link_to 'Create New Order', new_admin_order_path, class: 'btn btn-primary' %>
  </div>

  <div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body">
      <%= form_with url: admin_orders_path, method: :get, class: "row g-3 align-items-end" do |f| %>
        
        <div class="col-md-3">
          <%= f.label :invoice, "Invoice #", class: "small fw-bold" %>
          <%= f.text_field :invoice, value: params[:invoice], class: "form-control", placeholder: "VGN-XXXX" %>
        </div>

        <div class="col-md-3">
          <%= f.label :status, "Order Status", class: "small fw-bold" %>
          <%= f.select :status, Order.statuses.keys.map { |s| [s.titleize, s] }, { include_blank: 'All Statuses', selected: params[:status] }, { class: "form-select" } %>
        </div>

        <div class="col-md-4">
          <%= f.label :date_range, "Date Range", class: "small fw-bold" %>
          <div class="input-group">
            <%= f.date_field :start_date, value: params[:start_date], class: "form-control form-control-sm" %>
            <%= f.date_field :end_date, value: params[:end_date], class: "form-control form-control-sm" %>
          </div>
        </div>

        <div class="col-md-2 d-flex gap-1">
          <%= f.submit "Filter", class: "btn btn-dark btn-sm flex-grow-1" %>
          <%= link_to "Clear", admin_orders_path, class: "btn btn-outline-danger btn-sm" %>
        </div>

      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover shadow-sm">
      <thead class="table-dark">
        <tr>
          <th>Invoice #</th>
          <th>Customer</th>
          <th>Date</th>
          <th>Status</th>
          <th>Total</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @orders.each do |order| %>
          <tr>
            <td class="fw-bold text-success"><%= link_to order.invoice_number, admin_order_path(order), class: '' %></td>
            <td><%= order.customer&.name || "Walk-in" %></td>
            <td><%= order.order_date&.strftime("%d %b %y, %H:%M") %></td>
            <td><span class="badge bg-<%= status_color(order.status) %>"><%= order.status.titleize %></span></td>
            <td class="fw-bold">₹<%= order.total_amount %></td>
            <td>
              <%= link_to 'Edit', edit_admin_order_path(order), class: 'btn btn-sm btn-outline-dark' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>