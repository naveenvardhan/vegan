<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <div class="d-flex justify-content-end mb-3 d-print-none">
        <!-- <button onclick="window.print()" class="btn btn-outline-dark me-2">
          <i class="bi bi-printer"></i> Print Invoice
        </button> -->
        <%= link_to download_admin_order_path(@order, format: :pdf), class: "btn btn-danger" do %>
          <i class="bi bi-file-earmark-pdf"></i> Download Invoice
        <% end %>
        <%= link_to 'Edit Order', edit_admin_order_path(@order), class: 'btn btn-primary' %>
      </div>

      <div class="card shadow border-0 p-4">
        <div class="row mb-4">
          <div class="col-sm-6">
            <h1 class="text-success fw-bold">VEGAN FARM</h1>
            <p class="text-muted">Fresh from Farm to Table</p>
          </div>
          <div class="col-sm-6 text-sm-end">
            <h4 class="mb-0">INVOICE</h4>
            <div class="text-muted">#<%= @order.invoice_number %></div>
            <div class="text-muted">Date: <%= @order.order_date&.strftime("%d %b %Y") %></div>
          </div>
        </div>

        <hr>

        <div class="row mb-4">
          <div class="col-sm-6">
            <h6 class="text-muted text-uppercase small">Customer Details</h6>
            <div class="fw-bold"><%= @order.customer&.name || "Walk-in Customer" %></div>
            <div><%= @order.customer&.phone %></div>
            <div><%= @order.customer&.email %></div>
          </div>
          <div class="col-sm-6 text-sm-end">
            <h6 class="text-muted text-uppercase small">Order Status</h6>
            <span class="badge bg-<%= status_color(@order.status) %> fs-6">
              <%= @order.status.titleize %>
            </span>
          </div>
        </div>

        <div class="table-responsive mb-4">
          <table class="table table-striped border">
            <thead class="bg-light">
              <tr>
                <th>Item Description</th>
                <th class="text-center">Qty</th>
                <th class="text-end">Price</th>
                <th class="text-end">Subtotal</th>
              </tr>
            </thead>
            <tbody>
              <% @order.order_items.each do |oi| %>
                <tr>
                  <td><%= oi.item.name %></td>
                  <td class="text-center"><%= oi.quantity %> <%= oi.item.unit %></td>
                  <td class="text-end">₹<%= oi.price_at_order %></td>
                  <td class="text-end">₹<%= oi.quantity * oi.price_at_order %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="row justify-content-end">
          <div class="col-md-5 col-lg-4">
            <div class="d-flex justify-content-between mb-2">
              <span>Sub-total:</span>
              <span>₹<%= @order.sub_total %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span>Delivery Charge:</span>
              <span>₹<%= @order.delivery_charge || 0 %></span>
            </div>
            <div class="d-flex justify-content-between mb-2 text-danger">
              <span>Discount:</span>
              <span>- ₹<%= @order.discount || 0 %></span>
            </div>
            <div class="d-flex justify-content-between border-top pt-2 fw-bold fs-5 text-success">
              <span>Grand Total:</span>
              <span>₹<%= @order.total_amount %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>