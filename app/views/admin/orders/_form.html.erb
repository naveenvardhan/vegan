<div data-controller="nested-form" data-nested-form-prices-value="<%= Item.price_map.to_json %>">
  <%= form_with(model: [:admin, order], class: "row g-3") do |f| %>
    <div class="col-md-4">
      <%= f.label :customer_id, "Select Customer", class: "form-label" %>
      <%= f.collection_select :customer_id, Customer.where(is_active: true), :id, :name, { prompt: "Choose Customer" }, { class: "form-select" } %>
    </div>

    <div class="col-md-4">
      <%= f.label :order_date, class: "form-label" %>
      <%= f.datetime_field :order_date, class: "form-control", value: Time.current.strftime('%Y-%m-%dT%H:%M') %>
    </div>

    <div class="col-md-4">
      <%= f.label :status, class: "form-label" %>
      <%= f.select :status, Order.statuses.keys.map { |s| [s.titleize, s] }, {}, { class: "form-select" } %>
    </div>
    <template data-nested-form-target="template">
      <%= f.fields_for :order_items, OrderItem.new, child_index: "NEW_RECORD" do |item_f| %>
        <%= render "order_item_fields", f: item_f %>
      <% end %>
    </template>
    <div class="col-12 mt-4">
      <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
        <h5 class="mb-0">Order Items</h5>
        <button type="button" class="btn btn-sm btn-primary" data-action="nested-form#add">
          <i class="bi bi-plus-lg"></i> Add Another Item
        </button>
      </div>

      <table class="table table-bordered">
        <thead class="bg-light">
          <tr>
            <th style="width: 40%;">Product</th>
            <th style="width: 20%;">Quantity</th>
            <th style="width: 25%;">Price per Unit</th>
            <th style="width: 15%;">Action</th>
          </tr>
        </thead>
        <tbody data-nested-form-target="container">
          <%= f.fields_for :order_items do |item_f| %>
            <%= render "order_item_fields", f: item_f %>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-md-6 offset-md-6">
      <div class="card p-3 bg-light">
        <div class="row mb-2">
          <div class="col">Delivery Charge:</div>
          <div class="col"><%= f.number_field :delivery_charge, class: "form-control form-control-sm" %></div>
        </div>
        <div class="row mb-2">
          <div class="col">Discount:</div>
          <div class="col"><%= f.number_field :discount, class: "form-control form-control-sm" %></div>
        </div>
      </div>
    </div>
    
    <div class="col-12 mt-4">
      <%= f.submit "Save Order", class: "btn btn-success btn-lg w-100" %>
    </div>

    <% end %>
</div>