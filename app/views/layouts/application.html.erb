<!DOCTYPE html>
<html>
  <head>
    <title>Vegan</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <img src="/logos/logo-orange.png" class="card-img-top" style="width: 100px; object-fit: cover;" alt="">
        <% end %>
        <div class="d-flex align-items-center">
          <%= link_to cart_path, class: "btn btn-outline-dark position-relative" do %>
            <i class="bi bi-cart3"></i>
            <span id="cart_count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= @cart&.cart_items&.count || 0 %>
            </span>
          <% end %>
        </div>
      </div>
    </nav>
    <%= yield %>
  </body>
</html>
