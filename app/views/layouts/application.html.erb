<!DOCTYPE html>
<html>
  <head>
    <title>Vegan</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <link rel="icon" type="image/png" href="/logos/v-favicon.png">
    <link rel="shortcut icon" href="/logos/v-favicon.png" type="image/x-icon">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top py-1">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center" do %>
          <img src="/logos/logo-orange.png" class="card-img-top" style="width: 100px; object-fit: cover;" alt="">
        <% end %>
        <div class="d-flex align-items-center">
          <%= link_to cart_path, class: "btn btn-outline-dark position-relative px-2 py-1" do %>
            <i class="bi bi-cart3"></i>
            <span id="cart_count" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
              <%= @cart&.cart_items&.count || 0 %>
            </span>
          <% end %>
          
           <%# link_to destroy_customer_session_path, data: { turbo_method: :delete }, class: "btn btn-outline-dark px-2 py-1 rounded-4"  %>
          <% if current_customer.present? %>
            <div class="d-inline-flex flex-column align-items-center text-center mt-2" style="margin-left: 10px;">
              <%= link_to profile_path, data: {  }, class: "btn btn-outline-dark px-1 py-0 rounded-4", style: "" do %>
                <i class="bi bi-person"></i>
              <% end %>
              <span class="font-10"><%= current_customer&.profile_name %></span>
            </div>
          <% else %>
            <%= link_to new_customer_session_path, class: "text-decoration-none text-dark small", style: "margin-left: 10px;" do %>
              <div>
                Login
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </nav>
    
    <% if notice %>
      <div class="container mt-1">
        <div class="alert alert-success alert-dismissible fade show mb-1 py-2">
          <%= notice %>
          <button type="button" class="btn-close py-2 font-12 mt-2" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="container mt-1">
        <div class="alert alert-danger alert-dismissible fade show mb-1 py-2">
          <%= alert %>
          <button type="button" class="btn-close py-2 font-12 mt-2" data-bs-dismiss="alert"></button>
        </div>
      </div>
    <% end %>


    <%= yield %>

  </body>
</html>



