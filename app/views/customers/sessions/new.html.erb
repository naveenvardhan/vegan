<div class="container py-3 mt-5">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <% if flash[:alert].present? %>
          <div class="alert alert-danger alert-dismissible fade show">
            <%= flash[:alert] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>

        <% if flash[:notice].present? %>
          <div class="alert alert-success alert-dismissible fade show">
            <%= flash[:notice] %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% end %>
        
        <div class="card-header bg-dark text-white py-3">
          <h2 class="m-0">Log in</h2>
        </div>
        
        <div class="card-body p-4 pt-2">
          <div class="">
            New User? <a href="/customers/sign_up"> Create Account </a>
            <!-- link_to "Create Account", new_customer_registration_path %> -->

            <%#= render "devise/shared/links" %>
            <br>
            <br>
          </div>
          
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false } }) do |f| %>
            <% if resource.errors.any? %>
              <div class="alert alert-danger">
                <ul class="mb-0">
                  <% resource.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="field mb-3">
              <%= f.label :name, "Username", class: "form-label" %><br />
              <%= f.text_field :name, autofocus: true, class: "form-control" %>
              
              <% if resource.errors[:name].any? %>
                <div class="text-danger small">
                  <%= resource.errors[:name].first %>
                </div>
              <% end %>
            </div>
            

            <div class="mb-3">
              <%= f.label :phone, "Mobile Number", class: "form-label" %>
              <%= f.text_field :phone, class: "form-control" %>
              
              <% if resource.errors[:phone].any? %>
                <div class="text-danger small">
                  <%= resource.errors[:phone].first %>
                </div>
              <% end %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="field mb-3">
                <%= f.check_box :remember_me %>
                <%= f.label :remember_me %>
              </div>
            <% end %>

            <div class="actions">
              <%= f.submit "Log in", class: "btn btn-success" %>
            </div>
          <% end %>

          
        </div>
        
      </div>
    </div>
  </div>
</div>



