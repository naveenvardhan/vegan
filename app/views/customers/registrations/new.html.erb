<div class="container py-3 ">
  <div class="row justify-content-center">
    <div class="col-md-7">
      <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white py-3">
          <h2 class="m-0">Create Account</h2>
        </div>

        <div class="card-body p-4">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { novalidate: true }) do |f| %>
            <%#= render "devise/shared/error_messages", resource: resource %>

            <div class="field mb-3">
              <%= f.label :name, class: "form-label" %>
              <%= f.text_field :name, autofocus: true, class: "form-control #{"is-invalid" if resource.errors[:name].any?}", placeholder: "Enter full name" %>
              <% if resource.errors[:name].any? %>
                <div class="invalid-feedback d-block">
                  <i class="bi bi-exclamation-circle me-1"></i> Name <%= resource.errors[:name].first %>
                </div>
              <% end %>
            </div>

            <div class="field mb-3">
              <%= f.label :phone, "Mobile Number", class: "form-label" %>
              <div class="input-group has-validation">
                <span class="input-group-text bg-light text-muted">+91</span>
                <!-- <span class="input-group-text bg-light"><i class="bi bi-phone"></i></span> -->
                <%= f.telephone_field :phone, 
                    class: "form-control #{"is-invalid" if resource.errors[:phone].any?}", 
                    placeholder: "Enter 10 digit mobile number",
                    maxlength: 10,
                    pattern: "[0-9]{10}",
                    oninput: "this.value = this.value.replace(/[^0-9]/g, '');" %>
                
                <% if resource.errors[:phone].any? %>
                  <div class="invalid-feedback d-block">
                    <i class="bi bi-exclamation-circle me-1"></i>
                    Mobile number <%= resource.errors[:phone].first %>
                  </div>
                <% end %>
              </div>
            </div>

            <div class="field mb-3">
              <%= f.label :business_name, 'Business Name', class: "form-control-label" %>
              <%= f.text_field :business_name, class: "form-control #{"is-invalid" if resource.errors[:business_name].any?}", placeholder: "Udupi Veg" %>
              <% if resource.errors[:business_name].any? %>
                <div class="invalid-feedback d-block">
                  Enter your store name.
                </div>
              <% end %>
            </div>
              
            <div class="field mb-3">
              <%= f.label :business_type %><br />
              <%= f.select :business_type, ['Hotels & Restaurants', 'Catering', 'Seller'], {}, class: "form-select" %>
            </div>

            <div class="actions mt-4">
              <%= f.submit "Sign up", class: "btn btn-success" %>
            </div>
          <% end %>
          <div class="p-2">
            Already have an account? 
            <%= render "devise/shared/links" %>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>