<%# 1. Update the specific item's buttons %>
<%= turbo_stream.replace "item_#{@item.id}_cart_control" do %>
  <%= render partial: "home/item", locals: { item: @item, :@cart => @cart } %>
<% end %>

<% # 2. Update the navbar cart counter %>
<%= turbo_stream.update "cart_count" do %>
  <%= @cart.cart_items.count %>
<% end %>