<style media="screen">
  .form-control:focus{
    border-color: gainsboro;
    box-shadow: none;
  }
</style>
<div class="container p-1 px-2">
  <!-- <div class="p-5 mb-4 bg-light rounded-3 shadow-sm" style="background: linear-gradient(rgba(255,255,255,0.8), rgba(255,255,255,0.8)), url('http://localhost:3000/items/banner-2.jpg'); background-size: cover;">
    <div class="container-fluid py-5 text-center">
      <h1 class="display-5 fw-bold text-success">Vegan</h1>
      <p class="fs-4">Farm Fresh Vegetables & Seasonal Fruits directly from local farmers. Ready to deliver!</p>
      <button class="btn btn-success btn-lg" type="button">Browse Fruits</button>
    </div>
  </div> -->
  <!-- 🔍 Search Bar -->
  <!-- <div class="sticky-top bg-white pt-2 pb-2"> -->
  <div class="bg-white pb-2">
    <!-- local: true for not turbo -->
    <%= form_with url: root_path, method: :get, data: { turbo_frame: "items_list" }, class: "d-flex" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: "Search Vegetables", class: "form-control rounded-pill me-2 py-1 font-14", data: {controller: "search", action: "input->search#submit"} %>
      <button class="btn btn-success rounded-pill px-2" style="font-size: 13px; padding: 0px; height: 30px;">
        <i class="bi bi-search"></i>
      </button>
    <% end %>
  </div>
  
  


  <!-- <div class="mb-2">Today's Deal!</div> -->

  <!-- ================= MOBILE VIEW ================= -->
  <% if @last_order.present? %>

    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body py-1 px-3">

        <div class="d-flex justify-content-between align-items-center mb-2 mt-2">
          <h6 class="font-14 fw-bold text-success mb-0">🧾 Last Order</h6>

          <%= link_to "Repeat",
                repeat_order_path(@last_order),
                class: "btn btn-success btn-sm px-2 py-0 rounded-lg", style: "font-size: 12px;" %>
        </div>

        <% items = @last_order.order_items.includes(:item) %>
        <% visible_items = items.first(10) %>
        <% remaining = items.count - 10 %>

        <div class="d-flex flex-wrap gap-1">

          <% visible_items.each_with_index do |order_item, index| %>

            <% if index == 9 && remaining > 0 %>

              <!-- Last item with +N overlay -->
              <div style="width:67px; height:65px; position:relative;">
                <img src="/items/<%= order_item.item.image_path %>"
                     class="rounded border w-100 h-100"
                     style="object-fit:cover;opacity:0.6;">

                <div style="
                    position:absolute;
                    top:0;
                    left:0;
                    width:100%;
                    height:100%;
                    background:rgba(0,0,0,0.5);
                    color:white;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-weight:bold;">
                  +<%= remaining %>
                </div>
              </div>

            <% else %>

              <div style="width:67px; height:65px;">
                <img src="/items/<%= order_item.item.image_path %>"
                     class="rounded border w-100 h-100"
                     style="object-fit:cover;">
              </div>

            <% end %>

          <% end %>

        </div>

      </div>
    </div>

  <% else %>
    <!-- 🎠 Carousel -->
    <div id="mobileCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner rounded-3">

        <div class="carousel-item active">
          <img src="/logos/banner1.jpg" class="d-block w-100" style="height:150px; object-fit:cover;">
        </div>

        <div class="carousel-item">
          <img src="/logos/banner2.jpg" class="d-block w-100" style="height:150px; object-fit:cover;">
        </div>

        <div class="carousel-item">
          <img src="/logos/banner3.jpeg" class="d-block w-100" style="height:150px; object-fit:cover;">
        </div>

      </div>
    </div>
  <% end %>

  <div class="">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-1">
        
        
        
        <%= turbo_frame_tag "items_list" do %>
          <%= render partial: "items_list", locals: { items: @items } %>
        <% end %>

      </div>
    </div>
  </div>

</div>

<script>
  var myCarousel = document.querySelector('#mobileCarousel')
  var carousel = new bootstrap.Carousel(myCarousel, {
    interval: 2000,
    ride: 'carousel',
    pause: false,
    wrap: true
  })
</script>
