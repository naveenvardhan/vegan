<div class="container p-1 px-2">
  <!-- <div class="p-5 mb-4 bg-light rounded-3 shadow-sm" style="background: linear-gradient(rgba(255,255,255,0.8), rgba(255,255,255,0.8)), url('http://localhost:3000/items/banner-2.jpg'); background-size: cover;">
    <div class="container-fluid py-5 text-center">
      <h1 class="display-5 fw-bold text-success">Vegan</h1>
      <p class="fs-4">Farm Fresh Vegetables & Seasonal Fruits directly from local farmers. Ready to deliver!</p>
      <button class="btn btn-success btn-lg" type="button">Browse Fruits</button>
    </div>
  </div> -->
  <!-- 🔍 Search Bar -->
  <!-- <div class="sticky-top bg-white pt-2 pb-2"> -->
  <div class="bg-white pb-2">
    <!-- local: true for not turbo -->
    <%= form_with url: root_path, method: :get, data: { turbo_frame: "items_list" }, class: "d-flex" do |f| %>
      <%= f.text_field :query, value: params[:query], placeholder: "Search Vegetables", class: "form-control rounded-pill me-2", data: {controller: "search", action: "input->search#submit"} %>
      <button class="btn btn-success rounded-pill px-3">
        <i class="bi bi-search"></i>
      </button>
    <% end %>
  </div>
  
  <!-- 🎠 Carousel -->
  <div id="mobileCarousel" class="carousel slide mt-2" data-bs-ride="carousel">
    <div class="carousel-inner rounded-3">

      <div class="carousel-item active">
        <img src="/logos/banner1.jpg" class="d-block w-100" style="height:150px; object-fit:cover;">
      </div>

      <div class="carousel-item">
        <img src="/logos/banner2.jpg" class="d-block w-100" style="height:150px; object-fit:cover;">
      </div>

      <div class="carousel-item">
        <img src="/logos/banner3.jpeg" class="d-block w-100" style="height:150px; object-fit:cover;">
      </div>

    </div>
  </div>


  <!-- <div class="mb-2">Today's Deal!</div> -->

  <!-- ================= MOBILE VIEW ================= -->
  <div class="">
    <div class="card border-0 shadow-sm">
      <div class="card-body p-1">
        
        <%= turbo_frame_tag "items_list" do %>
          <%= render partial: "items_list", locals: { items: @items } %>
        <% end %>

      </div>
    </div>
  </div>

</div>

<script>
  var myCarousel = document.querySelector('#mobileCarousel')
  var carousel = new bootstrap.Carousel(myCarousel, {
    interval: 2000,
    ride: 'carousel',
    pause: false,
    wrap: true
  })
</script>
