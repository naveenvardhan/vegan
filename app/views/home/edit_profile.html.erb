<div class="container mb-5 mt-1" style="padding-bottom: 20rem;">
  <div class="card shadow-lg border-0 rounded-4">
    <div class="card-header bg-dark text-white rounded-top-4">
      <h4 class="mb-0">Edit Profile</h4>
    </div>

    <div class="card-body p-4">

      <%= form_with model: @customer,
            url: update_profile_path,
            method: :patch,
            local: true do |f| %>

        <div class="row">

          <!-- Name -->
          <div class="col-md-6 mb-3">
            <%= f.label :name, class: "form-label fw-semibold" %>
            <%= f.text_field :name,
                  class: "form-control rounded-3",
                  required: true %>
          </div>

          <!-- Phone -->
          <div class="col-md-6 mb-3">
            <%= f.label :phone, "Mobile Number", class: "form-label fw-semibold" %>
            <%= f.text_field :phone,
                  class: "form-control rounded-3",
                  required: true %>
          </div>

          <!-- Email -->
          <div class="col-md-6 mb-3">
            <%= f.label :email, class: "form-label fw-semibold" %>
            <%= f.email_field :email,
                  class: "form-control rounded-3",
                  required: true %>
          </div>

          <!-- Gender -->
          <div class="col-md-6 mb-3">
            <%= f.label :gender, class: "form-label fw-semibold" %>
            <%= f.select :gender,
                  ["Male", "Female", "Other"],
                  { prompt: "Select Gender" },
                  class: "form-select rounded-3" %>
          </div>

          <!-- Business Name -->
          <div class="col-md-12 mb-3">
            <%= f.label :business_name, class: "form-label fw-semibold" %>
            <%= f.text_field :business_name,
                  class: "form-control rounded-3" %>
          </div>

        </div>

        <div class="d-flex justify-content-between mt-4">
          <%= link_to "Back",
                profile_path,
                class: "btn btn-outline-secondary rounded-3" %>

          <%= f.submit "Update Profile",
                class: "btn btn-dark px-4 rounded-3" %>
        </div>

      <% end %>

    </div>
  </div>
</div>
