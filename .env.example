# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# Rails Secret Keys
# Generate SECRET_KEY_BASE with: docker compose run --rm web bundle exec rails secret
SECRET_KEY_BASE=your_secret_key_base_here

# Rails Master Key (from config/master.key or generate new credentials)
# Generate with: docker compose run --rm web bundle exec rails credentials:edit
RAILS_MASTER_KEY=your_rails_master_key_here

# Optional: Performance Tuning (defaults shown)
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
